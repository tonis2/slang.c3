# Symlinked out of an installed SDK by native/stage-slang.sh. 35 MB of somebody
# else's build, pointing at a path that is different on every machine — what is
# in git is the script, not the libraries.
lib/*/

# An SDK the script fetched because it found none installed: the release
# archive, checksum-verified, pruned to about 36 MB. Deleting it costs one
# re-download and nothing else.
.slang-sdk/

# Standalone build output
build/

# Object and debug files
*.o
*.obj
*.d
*.dSYM/
*.pdb
