# lib/<target>/libslang.a — Slang frozen into one static archive by
# native/build-slang.sh, fetched by native/fetch-static.sh off the `static`
# orphan branch. ~43 MB per target and rebuilt on every Slang bump, so what is
# in git is the scripts, not the archive.
lib/*/

# The Slang source tree and CMake tree build-slang.sh keeps, when neither
# $SLANG_C3_CACHE nor a cache directory under $HOME is writable.
.slang-sdk/

# Standalone build output
build/

# Object and debug files
*.o
*.obj
*.d
*.dSYM/
*.pdb
