{
  "provides": "slang",
  "sources": ["src/**"],
  // No C sources and no shim. Slang's `sp*` family passes nothing by value that
  // is not a scalar or a pointer, so there is no ABI bet of the kind
  // quickjs.c3l's shim exists to avoid — `extern fn` declarations reach it
  // directly. See the header of src/slang.c3.
  //
  // **The dylibs are not in git.** libslang is 27 MB, and vendoring it would put
  // that in this repository's history permanently — every SDK bump adding
  // another copy that no later commit can remove. `native/stage-slang.sh`
  // symlinks the two needed libraries out of an installed SDK into lib/<target>/
  // instead, finding it through $SLANG_SDK or slangc on PATH. Run it once per
  // checkout.
  //
  // Forgetting it fails at the linker with "library not found for -lslang" only
  // on a machine with no other Slang. Where one is installed somewhere the
  // linker searches by default, -lslang finds that one, links, and the build
  // dies at startup in dyld naming a version nobody asked for. See the README.
  "linklib-dir": "lib",
  //
  // **A consuming project on macOS wants `"macos-min-version": "15.0"` in its
  // own project.json.** It cannot be set here: `macos-min-version` is a project
  // property and c3c rejects it in a manifest by name. Without it c3c links for
  // macOS 11.0, the SDK's dylibs are built for something newer, and ld says so
  // on every single build — which buries anything real.
  "targets": {
    "macos-aarch64": {
      "linked-libraries": ["slang"],
      // libslang records its install name as @rpath/libslang-compiler.<ver>.dylib,
      // so the linker needs somewhere to look at *runtime* as well as at link
      // time. Both paths are relative — nothing here names a machine.
      //
      //   ../lib/slang.c3l/lib/macos-aarch64  the checkout, from an exe in build/
      //   .                                   the dylibs copied beside a shipped binary
      //
      // A deployment that wants neither can set DYLD_LIBRARY_PATH.
      "link-args": [
        "-Wl,-rpath,@executable_path/../lib/slang.c3l/lib/macos-aarch64",
        "-Wl,-rpath,@executable_path",
        // Slang is C++. A dylib records libc++ as its own dependency and the
        // consumer never sees it; a static archive does not, so the C++ runtime
        // has to be named here or every std:: symbol is undefined at link time.
        // Harmless on a dylib build, which already has it.
        // native/build-slang.sh is what produces the archive.
        "-lc++"
      ]
    },
    "macos-x64": {
      "linked-libraries": ["slang"],
      "link-args": [
        "-Wl,-rpath,@executable_path/../lib/slang.c3l/lib/macos-x64",
        "-Wl,-rpath,@executable_path"
      ]
    },
    "linux-x64": {
      "linked-libraries": ["slang"],
      "link-args": [
        "-Wl,-rpath,\\$ORIGIN/../lib/slang.c3l/lib/linux-x64",
        "-Wl,-rpath,\\$ORIGIN"
      ]
    },
    "linux-aarch64": {
      "linked-libraries": ["slang"],
      "link-args": [
        "-Wl,-rpath,\\$ORIGIN/../lib/slang.c3l/lib/linux-aarch64",
        "-Wl,-rpath,\\$ORIGIN"
      ]
    },
    // **Windows resolves this differently, in three ways, and none of them is
    // an rpath.**
    //
    // 1. `-lslang` reaches an IMPORT LIBRARY, `slang.lib`, not the DLL. Slang
    //    ships it under `lib/` with no `lib` prefix — the Unix targets above
    //    link `libslang.dylib`/`libslang.so` directly, and that name does not
    //    exist here. `native/stage-slang.sh` stages `slang.lib` under this
    //    same `linklib-dir`, so the manifest entry stays one word.
    //
    // 2. **There are no link-args**, and that is not an omission. Windows has
    //    no rpath: the loader searches the directory of the .exe, then the
    //    system directories, then PATH. Adding `-Wl,-rpath,...` here would be
    //    passed to a linker that does not take it.
    //
    // 3. The consequence, which the Unix targets do not have: a freshly built
    //    `build\three.exe` will NOT find `slang.dll`, because the DLLs are in
    //    `lib/slang.c3l/lib/windows-x64/` and that is not one of the places the
    //    loader looks. Either copy the two DLLs beside the exe or put that
    //    directory on PATH. A shipped bundle has them beside the binary already,
    //    which is why CI's smoke test runs from the bundle and not from build/.
    "windows-x64": {
      "linked-libraries": ["slang"]
    }
  }
}
