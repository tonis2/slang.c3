{
  "provides": "slang",
  "sources": ["src/**"],
  // No C sources and no shim. Slang's `sp*` family passes nothing by value that
  // is not a scalar or a pointer, so there is no ABI bet of the kind
  // quickjs.c3l's shim exists to avoid — `extern fn` declarations reach it
  // directly. See the header of src/slang.c3.
  //
  // **Slang is linked IN, as one static archive, and that is the only mode this
  // binding has.** lib/<target>/ holds libslang.a — slang.lib on Windows — and
  // nothing else. No dylibs, no rpaths, no SDK installed on the machine, and
  // nothing beside the finished binary. `native/fetch-static.sh` puts it there,
  // out of the `static` orphan branch; `native/build-slang.sh` is what built it.
  //
  // **The archive is not in git.** It is ~43 MB per target and is rebuilt on
  // every Slang bump, so main would keep every version of every target for
  // ever. Run `./native/fetch-static.sh` once per checkout. Skipping it fails
  // at the linker with "library not found for -lslang".
  "linklib-dir": "lib",
  //
  // **Every consumer must pass `-O0` to Slang.** The archives carry no
  // spirv-opt: it lives in libslang-glslang, which Slang dlopens by name rather
  // than links, so it cannot go inside an archive at all. Slang runs it at its
  // default -O1, so a compile that never mentions optimization still fails with
  // "failed to load downstream compiler 'spirv-opt'". See the README.
  //
  // **A consuming project on macOS wants `"macos-min-version": "26.0"`.** It
  // cannot be set here — `macos-min-version` is a project property and c3c
  // rejects it in a manifest by name. The archive is built with
  // CMAKE_OSX_DEPLOYMENT_TARGET=26.0 (native/build-slang.sh), and an object
  // built for a newer target than the binary linking it makes ld say so on
  // every single build, which is how a real warning gets missed.
  //
  // **`link-args` is the C++ runtime and nothing else now.** Slang is C++. A
  // shared library records libc++/libstdc++ as its own dependency and the
  // consumer never sees it; an archive does not, so it has to be named here or
  // every std:: symbol is undefined at link time.
  "targets": {
    "macos-aarch64": {
      "linked-libraries": ["slang"],
      "link-args": ["-lc++"]
    },
    "macos-x64": {
      "linked-libraries": ["slang"],
      "link-args": ["-lc++"]
    },
    // -lstdc++ rather than -lc++: build-slang.sh lets CMake pick the host C++
    // compiler, and on the distributions this gets built on that is gcc.
    //
    // **In `linked-libraries` after slang, not in `link-args` — for its
    // POSITION, the same reason windows-x64 names msvcrt below.** c3c emits a
    // library's link-args ahead of its linked-libraries, so `-lstdc++` there
    // lands *before* `-lslang`; GNU ld resolves left to right in one pass, takes
    // nothing out of libstdc++ because nothing needs it yet, and then ends in
    // thousands of undefined `operator new`, `__dynamic_cast` and
    // `__cxxabiv1::__si_class_type_info` references out of libslang.a. macOS
    // does not care — ld64 rescans archives — which is why macos-aarch64 can
    // keep -lc++ in link-args and this is a Linux-only trap.
    //
    // `-static-libstdc++` is worth considering instead for a binary meant to
    // run on older systems than the one that built it — otherwise the
    // executable picks up a version dependency on the build machine's libstdc++.
    "linux-x64": {
      "linked-libraries": ["slang", "stdc++"]
    },
    "linux-aarch64": {
      "linked-libraries": ["slang", "stdc++"]
    },
    // **`msvcrt` is named here, and only for its POSITION in the link line.**
    // c3c passes `... ucrt.lib vcruntime.lib msvcrt.lib`, and both of the last
    // two define __report_gsfailure — msvcrt.lib as a real object, vcruntime.lib
    // as a DLL import thunk. Slang is built with MSVC's default /GS, so its
    // objects reference __security_check_cookie, which only msvcrt.lib defines;
    // pulling it drags in __report_gsfailure too, and vcruntime.lib then replaces
    // that definition. lld-link refuses:
    //   lld-link: error: __report_gsfailure was replaced
    // A library's own linked-libraries land ahead of c3c's CRT list, so naming
    // msvcrt here lets it claim the symbol before vcruntime.lib is reached. The
    // archive is listed twice in the end, which costs nothing.
    //
    // **`slang.lib`, not `libslang.a`.** c3c reads a static library as
    // <name>.lib on Windows, with no `lib` prefix — the shape ktx.c3l ships
    // zstd.lib in. No link-args: the MSVC C++ runtime comes from the archive's
    // own CMAKE_MSVC_RUNTIME_LIBRARY and the consumer's build has to match it.
    "windows-x64": {
      "linked-libraries": ["slang", "msvcrt"]
    }
  }
}
