{
  // Standalone build, for developing and testing the binding on its own.
  // Consumers get `manifest.json` instead, which links the same library — the
  // two must be kept in step.
  //
  // They differ in one structural way: `manifest.json` can key
  // `linked-libraries` and `link-args` by platform and does, for five targets.
  // A `project.json` cannot — `targets` here means build products, not
  // platforms — so what is below is the host this is developed on. A Linux
  // checkout changes two strings; the manifest that consumers read already
  // covers it.
  //
  // `linklib-dir` is a manifest property and is not valid here, so the search
  // path is spelled out. There are no rpaths on either side any more: Slang is
  // a static archive, so nothing is looked up at runtime.
  //
  // `./native/fetch-static.sh` has to have been run, here as in any consumer —
  // lib/<target>/libslang.a is ~43 MB and is not in git.
  "langrev": "1",
  "warnings": ["no-unused"],
  "authors": [],
  "version": "0.1.0",
  "dependency-search-paths": [],
  "dependencies": [],
  "sources": ["src/**"],
  "test-sources": ["test/**"],
  "linked-libraries": ["slang"],
  "linker-search-paths": ["lib/macos-aarch64"],
  // Slang is C++, and an archive does not record libc++ as its own dependency
  // the way a dylib does. Without this every std:: symbol is undefined.
  "link-args": ["-lc++"],
  // The archive is built with CMAKE_OSX_DEPLOYMENT_TARGET=26.0, and an object
  // built for a newer target than the binary linking it makes ld say so on
  // every link unless it is told. See native/build-slang.sh.
  "macos-min-version": "26.0",
  "targets": {
    "slang": {
      "type": "static-lib"
    }
  },
  "output": "./build"
}
